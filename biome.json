{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": true,
		"ignore": ["node_modules", "**/node_modules/**", "dist", "coverage"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "space",
		"lineWidth": 100,
		"indentWidth": 2
	},
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noDebugger": "error",
				"noConsoleLog": "error",
				"noExplicitAny": "error",
				"noImplicitAnyLet": "error",
				"noArrayIndexKey": "off"
			},
			"correctness": {
				"noUnusedVariables": {
					"level": "error",
					"fix": "none"
				},
				"noUnusedImports": {
					"level": "error",
					"fix": "safe"
				},
				"noUndeclaredVariables": {
					"level": "error"
				}
			},
			"style": {
				"noVar": "error",
				"useConst": {
					"level": "error",
					"fix": "unsafe"
				},
				"noShoutyConstants": "error",
				"useTemplate": {
					"level": "error",
					"fix": "safe"
				}
			}
		}
	},
	"css": {
		"formatter": {
			"enabled": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		},
		"linter": {
			"enabled": true
		}
	}
}
